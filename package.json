{
  "name": "json-to-dom-datalist",
  "version": "1.2.2",
  "description": "Standalone, config-driven HTML5 <datalist> autocomplete renderer built on top of json-to-dom",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "bin": {
    "json-to-dom-datalist": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./v1": "./src/v1/index.js",
    "./v2": "./src/v2/index.js"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test test/unit.test.js",
    "build": "vite build"
  },
  "keywords": [
    "json-to-dom",
    "datalist",
    "autocomplete",
    "html5"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@keshavsoft/json-to-dom": "^1.31.3",
    "json-to-spec": "^19.1.0",
    "version": "^0.1.2"
  }
}
